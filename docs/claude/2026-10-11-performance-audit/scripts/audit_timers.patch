+    // AUDIT (2026-10-11 performance audit, experiment build only): one start-up table's wall time, resident memory
+    // after it and its own peak (VmHWM reset through /proc/self/clear_refs before it), with --sequential_load.
+    static std::pair<double, double> AuditMemoryMb() {  // VmRSS, VmHWM in MB
+        std::ifstream status("/proc/self/status");
+        std::string line;
+        double rss = -1, hwm = -1;
+        while (std::getline(status, line)) {
+            if (line.rfind("VmRSS:", 0) == 0) rss = std::stod(line.substr(6)) / 1024.0;
+            else if (line.rfind("VmHWM:", 0) == 0) hwm = std::stod(line.substr(6)) / 1024.0;
+        }
+        return { rss, hwm };
+    }
+    template<typename Load>
+    static void AuditTimed(char const* name, Load&& load) {
+        { std::ofstream reset("/proc/self/clear_refs"); reset << "5"; }
+        auto const before = AuditMemoryMb();
+        auto const start = std::chrono::steady_clock::now();
+        load();
+        double const seconds = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+        auto const after = AuditMemoryMb();
+        std::cout << "AUDIT table\t" << name << "\t" << std::fixed << std::setprecision(4) << seconds << "\ts\trss_before_mb\t"
+                  << std::setprecision(1) << before.first << "\trss_after_mb\t" << after.first << "\tpeak_mb\t" << after.second << std::endl;
+    }
