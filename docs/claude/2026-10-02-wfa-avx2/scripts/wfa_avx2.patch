diff --git a/lib/wfa2-extend/extend_avx2.c b/lib/wfa2-extend/extend_avx2.c
new file mode 100644
index 0000000..d741753
--- /dev/null
+++ b/lib/wfa2-extend/extend_avx2.c
@@ -0,0 +1,84 @@
+// WFA2-lib's packed extend kernels with AVX2, compiled with -mavx2 by lib/wfa2-lib.cmake, which
+// extend_dispatch.c calls where the CPU has AVX2.
+//
+// They are upstream's portable kernels (wavefront_extend_kernels.c) with the matches on a diagonal counted
+// 32 characters at a time instead of 8: the same diagonals in the same order, the same checks for the
+// alignment's end, so the same alignments. Upstream's own AVX2 kernels (wavefront_extend_kernels_avx.c)
+// gather 4 characters of 8 diagonals at once and extend the diagonals that matched them one by one; on an
+// Intel Core Ultra 7 258V they were 1-14% slower than the portable kernels for reads of 1-30% divergence,
+// and their ends-free kernel can end on another diagonal of the same score than the portable one.
+//
+// Reading 32 characters is safe: WFA2-lib keeps its pattern and text with 64 bytes after each
+// (WF_SEQUENCES_PADDING), an extension starts at most at a sequence's end, and the end characters of the
+// pattern and the text differ ('!', '?'), so a diagonal's matches stop there at the latest.
+#ifndef __AVX2__
+#error "lib/wfa2-extend/extend_avx2.c is compiled with -mavx2 (lib/wfa2-lib.cmake)"
+#endif
+#include <immintrin.h>
+#include "wavefront/wavefront_extend_kernels.h"
+#include "wavefront/wavefront_termination.h"
+
+// Extends diagonal k from offset: the offset after the matches that follow it.
+static inline wf_offset_t ExtendAvx2(const wavefront_aligner_t* const wf_aligner, const int k, wf_offset_t offset) {
+  const char* pattern = wf_aligner->sequences.pattern + WAVEFRONT_V(k,offset);
+  const char* text = wf_aligner->sequences.text + WAVEFRONT_H(k,offset);
+  for (;;) {
+    const __m256i p = _mm256_loadu_si256((const __m256i*)pattern);
+    const __m256i t = _mm256_loadu_si256((const __m256i*)text);
+    const unsigned int differ = ~(unsigned int)_mm256_movemask_epi8(_mm256_cmpeq_epi8(p,t));
+    if (differ != 0) return offset + __builtin_ctz(differ);
+    offset += 32;
+    pattern += 32;
+    text += 32;
+  }
+}
+
+void protal_wfa_avx2_extend_end2end(
+    wavefront_aligner_t* const wf_aligner,
+    wavefront_t* const mwavefront,
+    const int lo,
+    const int hi) {
+  wf_offset_t* const offsets = mwavefront->offsets;
+  int k;
+  for (k=lo;k<=hi;++k) {
+    const wf_offset_t offset = offsets[k];
+    if (offset == WAVEFRONT_OFFSET_NULL) continue;
+    offsets[k] = ExtendAvx2(wf_aligner,k,offset);
+  }
+}
+
+wf_offset_t protal_wfa_avx2_extend_end2end_max(
+    wavefront_aligner_t* const wf_aligner,
+    wavefront_t* const mwavefront,
+    const int lo,
+    const int hi) {
+  wf_offset_t* const offsets = mwavefront->offsets;
+  wf_offset_t max_antidiag = 0;
+  int k;
+  for (k=lo;k<=hi;++k) {
+    const wf_offset_t offset = offsets[k];
+    if (offset == WAVEFRONT_OFFSET_NULL) continue;
+    offsets[k] = ExtendAvx2(wf_aligner,k,offset);
+    const wf_offset_t antidiag = WAVEFRONT_ANTIDIAGONAL(k,offsets[k]);
+    if (max_antidiag < antidiag) max_antidiag = antidiag;
+  }
+  return max_antidiag;
+}
+
+bool protal_wfa_avx2_extend_endsfree(
+    wavefront_aligner_t* const wf_aligner,
+    wavefront_t* const mwavefront,
+    const int score,
+    const int lo,
+    const int hi) {
+  wf_offset_t* const offsets = mwavefront->offsets;
+  int k;
+  for (k=lo;k<=hi;++k) {
+    wf_offset_t offset = offsets[k];
+    if (offset == WAVEFRONT_OFFSET_NULL) continue;
+    offset = ExtendAvx2(wf_aligner,k,offset);
+    offsets[k] = offset;
+    if (wavefront_termination_endsfree(wf_aligner,mwavefront,score,k,offset)) return true;
+  }
+  return false;
+}
diff --git a/lib/wfa2-extend/extend_dispatch.c b/lib/wfa2-extend/extend_dispatch.c
new file mode 100644
index 0000000..875e801
--- /dev/null
+++ b/lib/wfa2-extend/extend_dispatch.c
@@ -0,0 +1,61 @@
+// WFA2-lib's packed extend kernels (wavefront_extend_kernels.h) as the rest of WFA2-lib calls them: where
+// the CPU has AVX2, protal's AVX2 kernels (extend_avx2.c), else upstream's portable kernels
+// (extend_scalar.c). Upstream chooses at compile time (#if __AVX2__), which in
+// protal's build for any x86-64 left the AVX2 kernels out. Both give the same alignments
+// (WFA2Wrapper.TheAvx2ExtendKernelsAlignAsThePortableOnes).
+#include "wavefront/wavefront_extend_kernels.h"
+#include "extend_dispatch.h"
+
+// extend_scalar.c
+void protal_wfa_scalar_extend_end2end(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                      const int lo, const int hi);
+wf_offset_t protal_wfa_scalar_extend_end2end_max(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                                 const int lo, const int hi);
+bool protal_wfa_scalar_extend_endsfree(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                       const int score, const int lo, const int hi);
+// extend_avx2.c
+void protal_wfa_avx2_extend_end2end(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                    const int lo, const int hi);
+wf_offset_t protal_wfa_avx2_extend_end2end_max(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                               const int lo, const int hi);
+bool protal_wfa_avx2_extend_endsfree(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                     const int score, const int lo, const int hi);
+
+// Set before main (and before any thread) by Choose; tests switch it between alignments.
+static bool use_avx2 = false;
+
+static bool CpuHasAvx2(void) {
+    // In a constructor, before libgcc's own CPU detection may have run.
+    __builtin_cpu_init();
+    return __builtin_cpu_supports("avx2");
+}
+
+__attribute__((constructor)) static void Choose(void) {
+    use_avx2 = CpuHasAvx2();
+}
+
+bool protal_wfa_extend_uses_avx2(void) {
+    return use_avx2;
+}
+
+void protal_wfa_extend_use_avx2(bool use) {
+    use_avx2 = use && CpuHasAvx2();
+}
+
+void wavefront_extend_matches_packed_end2end(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                             const int lo, const int hi) {
+    if (use_avx2) protal_wfa_avx2_extend_end2end(wf_aligner, mwavefront, lo, hi);
+    else protal_wfa_scalar_extend_end2end(wf_aligner, mwavefront, lo, hi);
+}
+
+wf_offset_t wavefront_extend_matches_packed_end2end_max(wavefront_aligner_t* const wf_aligner,
+                                                        wavefront_t* const mwavefront, const int lo, const int hi) {
+    return use_avx2 ? protal_wfa_avx2_extend_end2end_max(wf_aligner, mwavefront, lo, hi)
+                    : protal_wfa_scalar_extend_end2end_max(wf_aligner, mwavefront, lo, hi);
+}
+
+bool wavefront_extend_matches_packed_endsfree(wavefront_aligner_t* const wf_aligner, wavefront_t* const mwavefront,
+                                              const int score, const int lo, const int hi) {
+    return use_avx2 ? protal_wfa_avx2_extend_endsfree(wf_aligner, mwavefront, score, lo, hi)
+                    : protal_wfa_scalar_extend_endsfree(wf_aligner, mwavefront, score, lo, hi);
+}
diff --git a/lib/wfa2-extend/extend_dispatch.h b/lib/wfa2-extend/extend_dispatch.h
new file mode 100644
index 0000000..4a61b07
--- /dev/null
+++ b/lib/wfa2-extend/extend_dispatch.h
@@ -0,0 +1,23 @@
+// Which of WFA2-lib's extend kernels protal's WFA2 runs: upstream's AVX2 kernels where the CPU has AVX2,
+// its portable kernels elsewhere (extend_dispatch.c). Chosen when the program starts; tests switch it to
+// compare both, between alignments.
+#ifndef PROTAL_WFA_EXTEND_DISPATCH_H_
+#define PROTAL_WFA_EXTEND_DISPATCH_H_
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Whether the extend kernels use AVX2.
+bool protal_wfa_extend_uses_avx2(void);
+
+// Uses the AVX2 kernels if `use` and the CPU has AVX2, else the portable ones. Not while aligning.
+void protal_wfa_extend_use_avx2(bool use);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/lib/wfa2-extend/extend_scalar.c b/lib/wfa2-extend/extend_scalar.c
new file mode 100644
index 0000000..64e99e3
--- /dev/null
+++ b/lib/wfa2-extend/extend_scalar.c
@@ -0,0 +1,7 @@
+// WFA2-lib's extend kernels (wavefront_extend_kernels.c, unmodified) for any x86-64, under the names that
+// extend_dispatch.c calls when the CPU has no AVX2. wavefront_extend_matches_custom keeps its name: it has
+// no AVX2 kernel.
+#define wavefront_extend_matches_packed_end2end protal_wfa_scalar_extend_end2end
+#define wavefront_extend_matches_packed_end2end_max protal_wfa_scalar_extend_end2end_max
+#define wavefront_extend_matches_packed_endsfree protal_wfa_scalar_extend_endsfree
+#include "wavefront/wavefront_extend_kernels.c"
diff --git a/lib/wfa2-lib.cmake b/lib/wfa2-lib.cmake
index b468bd0..120fd3b 100644
--- a/lib/wfa2-lib.cmake
+++ b/lib/wfa2-lib.cmake
@@ -8,7 +8,8 @@
 # Upstream's own CMakeLists.txt is not used: in Release builds it adds -march=native (the baseline
 # protal binary must run on any x86-64), and it needs pkg-config and builds shared libraries, a
 # benchmark tool and a test. The source list and include directories below are upstream's
-# (wfa2lib_SOURCE + the C++ binding); keep them in sync when updating the library. Compiler flags
+# (wfa2lib_SOURCE + the C++ binding), but for the two extend kernel files, which are built through
+# lib/wfa2-extend (further below); keep them in sync when updating the library. Compiler flags
 # come from protal's build type. WFA_PARALLEL stays undefined: protal parallelises over reads.
 
 set(WFA2_DIR ${CMAKE_CURRENT_LIST_DIR}/wfa2-lib)
@@ -40,8 +41,6 @@ set(WFA2_SOURCES
         wavefront/wavefront_slab.c
         wavefront/wavefront_unialign.c
         wavefront/wavefront_termination.c
-        wavefront/wavefront_extend_kernels_avx.c
-        wavefront/wavefront_extend_kernels.c
         system/mm_stack.c
         system/mm_allocator.c
         system/profiler_counter.c
@@ -60,8 +59,24 @@ set(WFA2_SOURCES
         bindings/cpp/WFAligner.cpp)
 list(TRANSFORM WFA2_SOURCES PREPEND ${WFA2_DIR}/)
 
+# The extend kernels (upstream's wavefront_extend_kernels.c and wavefront_extend_kernels_avx.c, also part
+# of wfa2lib_SOURCE). Upstream chooses its AVX2 kernels at compile time (#if __AVX2__), which for any
+# x86-64 leaves them out, and they were slower here than the portable ones anyway. On x86 with GCC or
+# Clang, lib/wfa2-extend builds the portable kernels under other names (extend_scalar.c) and, with
+# -mavx2, protal's AVX2 versions of them (extend_avx2.c); extend_dispatch.c gives upstream's names to
+# whichever the CPU runs. Elsewhere, upstream's two files as they are.
+set(WFA2_EXTEND_DIR ${CMAKE_CURRENT_LIST_DIR}/wfa2-extend)
+if (CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|i[3-6]86)$" AND CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
+    set(WFA2_EXTEND_RUNTIME ON)
+    list(APPEND WFA2_SOURCES ${WFA2_EXTEND_DIR}/extend_scalar.c ${WFA2_EXTEND_DIR}/extend_dispatch.c)
+else()
+    set(WFA2_EXTEND_RUNTIME OFF)
+    list(APPEND WFA2_SOURCES ${WFA2_DIR}/wavefront/wavefront_extend_kernels.c ${WFA2_DIR}/wavefront/wavefront_extend_kernels_avx.c)
+endif()
+message(STATUS "WFA2 extend kernels with AVX2 chosen at run time: ${WFA2_EXTEND_RUNTIME}")
+
 add_library(wfa_lib STATIC ${WFA2_SOURCES})
-target_include_directories(wfa_lib PUBLIC ${WFA2_DIR} ${WFA2_DIR}/wavefront ${WFA2_DIR}/utils)
+target_include_directories(wfa_lib PUBLIC ${WFA2_DIR} ${WFA2_DIR}/wavefront ${WFA2_DIR}/utils ${WFA2_EXTEND_DIR})
 target_compile_definitions(wfa_lib PRIVATE _FILE_OFFSET_BITS=64)
 # UBSan is off for WFA2 (ASan stays on): it compares sequences in unaligned 8-byte blocks and shifts
 # negative offsets left, idioms UBSan reports and that would stop a sanitizer run with
@@ -69,3 +84,11 @@ target_compile_definitions(wfa_lib PRIVATE _FILE_OFFSET_BITS=64)
 # outside sanitizer builds.
 target_compile_options(wfa_lib PRIVATE -fno-sanitize=undefined)
 set_target_properties(wfa_lib PROPERTIES LINKER_LANGUAGE CXX)
+
+if (WFA2_EXTEND_RUNTIME)
+    add_library(wfa_extend_avx2 OBJECT ${WFA2_EXTEND_DIR}/extend_avx2.c)
+    target_include_directories(wfa_extend_avx2 PRIVATE ${WFA2_DIR} ${WFA2_DIR}/wavefront ${WFA2_DIR}/utils)
+    target_compile_definitions(wfa_extend_avx2 PRIVATE _FILE_OFFSET_BITS=64)
+    target_compile_options(wfa_extend_avx2 PRIVATE -mavx2 -fno-sanitize=undefined)
+    target_sources(wfa_lib PRIVATE $<TARGET_OBJECTS:wfa_extend_avx2>)
+endif()
diff --git a/tests/test_WFA2Wrapper.cpp b/tests/test_WFA2Wrapper.cpp
index fc222d2..2fb6981 100644
--- a/tests/test_WFA2Wrapper.cpp
+++ b/tests/test_WFA2Wrapper.cpp
@@ -1,10 +1,12 @@
 // Unit tests for protal's WFA2 wrapper: --x_drop reaches WFA2 (also in the copies alignment threads
 // use), its default changes no alignment, and an alignment X-drop breaks is reported as failed
-// rather than as a successful alignment that does not fit the read.
+// rather than as a successful alignment that does not fit the read. WFA2's AVX2 extend kernels align as
+// its portable ones.
 #include <gtest/gtest.h>
 #include <random>
 #include <string>
 #include "Alignment/WFA2Wrapper2.h"
+#include "wfa2-extend/extend_dispatch.h"
 
 using namespace protal;
 
@@ -116,3 +118,60 @@ TEST(WFA2Wrapper, TheDefaultXDropChangesNoAlignment) {
         }
     }
 }
+
+// WFA2's extend kernels: upstream's AVX2 ones where the CPU has AVX2 (lib/wfa2-extend), its portable ones
+// elsewhere. Both give every alignment the same operations and score: protal's 150 bp reads ends-free with
+// and without X-drop, and long reads end to end and ends-free, with and without wf-adaptive (the kernels
+// with and without the maximum antidiagonal).
+TEST(WFA2Wrapper, TheAvx2ExtendKernelsAlignAsThePortableOnes) {
+    struct Restore {
+        bool const before = protal_wfa_extend_uses_avx2();
+        ~Restore() { protal_wfa_extend_use_avx2(before); }
+    } restore;
+    protal_wfa_extend_use_avx2(true);
+    if (!protal_wfa_extend_uses_avx2()) GTEST_SKIP() << "this CPU has no AVX2 (or this build no AVX2 kernels)";
+
+    std::mt19937 rng(17);
+    size_t compared = 0;
+    for (size_t const x_drop : { size_t{0}, size_t{50}, size_t{1000} }) {
+        for (auto const& c : Cases(1500, rng)) {
+            std::string cigar[2];
+            int score[2];
+            bool ok[2];
+            for (int avx2 = 0; avx2 < 2; avx2++) {
+                protal_wfa_extend_use_avx2(avx2 == 1);
+                WFA2Wrapper2 aligner(4, 6, 2, x_drop);
+                aligner.Alignment(c.read, c.ref, 0, c.q_end_free, c.r_begin_free, c.r_end_free, 61);
+                ok[avx2] = aligner.Success();
+                cigar[avx2] = ok[avx2] ? aligner.Cigar() : "";
+                score[avx2] = ok[avx2] ? aligner.GetAlignmentScore() : 0;
+            }
+            ASSERT_EQ(ok[0], ok[1]) << c.read;
+            EXPECT_EQ(cigar[0], cigar[1]) << c.read;
+            EXPECT_EQ(score[0], score[1]) << c.read;
+            compared++;
+        }
+    }
+    for (int i = 0; i < 60; i++) {
+        std::uniform_real_distribution<double> rate(0.0, 0.15);
+        std::string const ref = Random(2000 + rng() % 8000, rng);
+        std::string const read = Mutate(ref, rate(rng), rng);
+        bool const ends_free = i % 2 == 1, adaptive = i % 4 >= 2;
+        std::string cigar[2];
+        int score[2];
+        for (int avx2 = 0; avx2 < 2; avx2++) {
+            protal_wfa_extend_use_avx2(avx2 == 1);
+            WFAlignerGapAffine aligner(4, 6, 2, WFAligner::Alignment, WFAligner::MemoryHigh);
+            if (adaptive) aligner.setHeuristicWFadaptive(10, 50, 1);
+            else aligner.setHeuristicNone();
+            auto const status = ends_free ? aligner.alignEndsFree(ref, 100, 100, read, 0, 0) : aligner.alignEnd2End(ref, read);
+            ASSERT_EQ(status, WFAligner::StatusAlgCompleted);
+            cigar[avx2] = aligner.getAlignment();
+            score[avx2] = aligner.getAlignmentScore();
+        }
+        EXPECT_EQ(cigar[0], cigar[1]) << "long read " << i;
+        EXPECT_EQ(score[0], score[1]) << "long read " << i;
+        compared++;
+    }
+    EXPECT_EQ(compared, 3 * 1500 + 60u);
+}
