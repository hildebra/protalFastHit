+TEST(ReadConsensus, ACycleGoesToTheTaxonWithTheSmallestDefeat) {
+    // The shape of a K-12 HiFi read (docs/claude/2026-10-13-ecoli-hifi, read 13443), an edit 5 points: taxon 2 has
+    // candidates on all 8 genes, taxon 1 on 6 and beats it there by 20; taxon 3 on 3 of those, where it beats taxon 1
+    // by one edit and loses to taxon 2 by two. Every taxon loses to one; the smallest defeat is taxon 1's.
+    std::vector<std::vector<PartCandidate>> const parts = {
+        { { 2, 1000 }, { 1, 1010 } },
+        { { 2, 1000 }, { 1, 1015 } },
+        { { 2, 1000 }, { 1, 1010 } },
+        { { 2, 1015 }, { 1, 1000 }, { 3, 1000 } },
+        { { 2, 1005 }, { 1, 1005 }, { 3, 1005 } },
+        { { 2, 1000 }, { 1, 1000 }, { 3, 1005 } },
+        { { 2, 1000 } },
+        { { 2, 1000 } },
+    };
+    auto const read = ConsensusOfRead(parts, 4);
+    ASSERT_TRUE(read.has_value());
+    EXPECT_EQ(read->taxid, 1u);  // until 2026-10-13 taxon 2, with candidates on the most genes
+    EXPECT_EQ(read->parts, 6u);
+    // Its MAPQ against the closest other taxon on its genes, taxon 2 (taxon 3 lacks three of them).
+    EXPECT_EQ(read->mapq, std::min(MAPQv2(6040, 6020), MAPQv2(6040, 3010)));
+
+    // Only taxa on enough parts can be the consensus: with 7 needed, taxon 2, though it loses by more.
+    auto const enough = ConsensusOfRead(parts, 7);
+    ASSERT_TRUE(enough.has_value());
+    EXPECT_EQ(enough->taxid, 2u);
+    EXPECT_FALSE(ConsensusOfRead(parts, 9).has_value());
+
+    // Equal smallest defeats: the most parts, then the highest total. Taxon 1 loses to 2 on part 0, 2 to 3 on part 1,
+    // 3 to 1 on part 2, each by one edit; taxon 3 has the most parts.
+    auto const tied = ConsensusOfRead({ { { 1, 100 }, { 2, 105 } }, { { 2, 100 }, { 3, 105 } }, { { 3, 100 }, { 1, 105 } }, { { 3, 50 } } });
+    ASSERT_TRUE(tied.has_value());
+    EXPECT_EQ(tied->taxid, 3u);
+}
