 namespace protal {
+    // EXPERIMENT ONLY (SAM step timing): milliseconds since the last call, printed as SAMSTEP lines.
+    inline void SamStep(char const* what) {
+        static auto last = std::chrono::steady_clock::now();
+        auto const now = std::chrono::steady_clock::now();
+        std::fprintf(stderr, "SAMSTEP\t%s\t%.1f\n", what, std::chrono::duration<double, std::milli>(now - last).count());
+        last = now;
+    }
+
     enum class SamCompression { None, Gzip, Zstd };
 
