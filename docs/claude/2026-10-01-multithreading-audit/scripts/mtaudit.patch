diff -ruN orig/src/Utilities/MtAudit.h instr-src/src/Utilities/MtAudit.h
--- a/src/Utilities/MtAudit.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/Utilities/MtAudit.h	2026-10-01 18:06:33.384979337 +0100
@@ -0,0 +1,65 @@
+// MtAudit.h - experiment only (multithreading audit, 2026-10-01): wall-clock counters around the
+// locks and hand-offs of a run, printed to stderr when the process ends. Not for the tree.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+
+namespace mtaudit {
+    inline uint64_t Now() {
+        return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now().time_since_epoch()).count());
+    }
+
+    struct Counter {
+        std::atomic<uint64_t> ns{0}, n{0};
+        void Add(uint64_t d) { ns.fetch_add(d, std::memory_order_relaxed); n.fetch_add(1, std::memory_order_relaxed); }
+    };
+
+    struct Counters {
+        Counter reader_wait;       // waiting to enter critical(reader)
+        Counter reader_hold;       // inside critical(reader)
+        Counter underflow_wait;    // inside it: waiting for an inflated block (consumers faster than inflate)
+        Counter inflate_busy;      // inflating thread: filling a block (all streams)
+        Counter inflate_idle;      // inflating thread: waiting for a free block (inflate faster than consumers)
+        std::atomic<uint64_t> inflated_bytes{0};
+        Counter sam_pack;          // SamOutput::Write: compressing, outside the lock
+        Counter sam_wait;          // waiting for its mutex
+        Counter sam_hold;          // holding it (set insert, write())
+        std::atomic<uint64_t> sam_bytes{0};
+        Counter prof_total;        // ProfileSam: whole
+        Counter prof_group;        // its on_group callbacks (BestOfGroup, ProcessMAPQ, AddSam ...)
+        Counter prof_addsam;       // MicrobialProfile::AddSam inside them
+        Counter prof_post;         // ApplyRecordEvidence + PostProcessSNPs
+        uint64_t start = Now();
+
+        ~Counters() {
+            double const wall = (Now() - start) / 1e9;
+            auto row = [](char const* name, Counter const& c) {
+                std::fprintf(stderr, "MTAUDIT\t%s\t%.6f\t%llu\n", name, c.ns.load() / 1e9, static_cast<unsigned long long>(c.n.load()));
+            };
+            std::fprintf(stderr, "MTAUDIT\twall\t%.6f\t1\n", wall);
+            row("reader_wait", reader_wait);
+            row("reader_hold", reader_hold);
+            row("underflow_wait", underflow_wait);
+            row("inflate_busy", inflate_busy);
+            row("inflate_idle", inflate_idle);
+            std::fprintf(stderr, "MTAUDIT\tinflated_bytes\t%llu\t1\n", static_cast<unsigned long long>(inflated_bytes.load()));
+            row("sam_pack", sam_pack);
+            row("sam_wait", sam_wait);
+            row("sam_hold", sam_hold);
+            std::fprintf(stderr, "MTAUDIT\tsam_bytes\t%llu\t1\n", static_cast<unsigned long long>(sam_bytes.load()));
+            row("prof_total", prof_total);
+            row("prof_group", prof_group);
+            row("prof_addsam", prof_addsam);
+            row("prof_post", prof_post);
+        }
+    };
+
+    inline Counters& Get() {
+        static Counters counters;
+        return counters;
+    }
+}
