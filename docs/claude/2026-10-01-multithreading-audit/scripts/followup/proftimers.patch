diff -ruN orig/src/Utilities/ProfTimers.h src/src/Utilities/ProfTimers.h
--- a/src/Utilities/ProfTimers.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/Utilities/ProfTimers.h	2026-10-01 20:09:59.234629592 +0100
@@ -0,0 +1,28 @@
+// ProfTimers.h - experiment only (parallel profiling, 2026-10-01): wall-clock scope timers, printed at exit.
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <string>
+namespace proftimers {
+    struct Table {
+        std::mutex mutex;
+        std::map<std::string, std::pair<double, size_t>> rows;
+        ~Table() { for (auto const& [k, v] : rows) std::fprintf(stderr, "PROFT\t%s\t%.6f\t%zu\n", k.c_str(), v.first, v.second); }
+    };
+    inline Table& Get() { static Table t; return t; }
+    struct Scope {
+        char const* name; std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+        explicit Scope(char const* n) : name(n) {}
+        ~Scope() {
+            double const s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+            std::lock_guard<std::mutex> lock(Get().mutex);
+            auto& r = Get().rows[name]; r.first += s; r.second++;
+        }
+    };
+}
+#define PT_CAT2(a, b) a##b
+#define PT_CAT(a, b) PT_CAT2(a, b)
+#define PT_SCOPE(name) proftimers::Scope PT_CAT(pt_scope_, __LINE__)(name)
